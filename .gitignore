# === SUNO_client — .gitignore ===
# Decisión (Paso 0): el código que genera build_runner (*.g.dart, *.freezed.dart)
# y gen-l10n (lib/l10n/app_localizations*.dart) NO se versiona: se regenera con
# `dart run build_runner build` y `flutter gen-l10n` (también en CI). Si alguna
# vez hace falta versionar uno, se excepciona aquí con `!ruta` y su motivo.
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
lib/l10n/app_localizations*.dart

# --- Flutter / Dart / Pub ---
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
app.*.symbols
app.*.map.json

# --- Android ---
/android/app/debug
/android/app/profile
/android/app/release
android/local.properties
android/**/gradle-wrapper.jar
android/.gradle/

# --- iOS ---
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# --- Secretos: la llave de subida de Android nunca entra al repo ---
android/key.properties
*.jks
*.keystore
.env
.env.*
*.pem
*.key
secrets/

# --- Herramientas de CI en local ---
.venv/
venv/
__pycache__/
*.pyc

# --- Editores / SO ---
*.class
*.log
*.swp
*.iml
*.ipr
*.iws
.idea/
.vscode/
.history
.DS_Store
Thumbs.db
migrate_working_dir/
